{
  "manifest_version": 3,
  "name": "FactGuard — Перевірка новин",
  "version": "1.0.0",
  "description": "Аналіз маніпуляцій у новинах та автоматичний перехресний фактчекінг у незалежних медіа.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FactGuard — Перевірка новин",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/news-analyzer.js", "src/ui.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
